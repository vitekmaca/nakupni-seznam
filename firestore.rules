rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Přístup jen k seznamu se známým dlouhým ID (je v firebase-config.js). Výpis všech seznamů je zakázaný.
    match /lists/{listId} {
      allow get, create, update: if listId.size() >= 16;
      match /items/{itemId} {
        allow read, write: if listId.size() >= 16;
      }
    }
  }
}
