rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Domácnosti zakládá jen správce v konzoli. ID seznamu se počítá z názvu a kódu domácnosti.
    match /lists/{listId} {
      allow get, update: if listId.size() == 64;
      match /items/{itemId} {
        allow read, write: if listId.size() == 64
          && exists(/databases/$(database)/documents/lists/$(listId));
      }
    }
  }
}
